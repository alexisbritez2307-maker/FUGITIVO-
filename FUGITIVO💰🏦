    title.TextStrokeTransparency = 0.1 + pulse * 0.2
    glow1.TextStrokeTransparency = 0.4 + pulse * 0.3
    glow2.TextStrokeTransparency = 0.4 + pulse * 0.3
    glow3.TextStrokeTransparency = 0.6 + pulse * 0.3
    glow4.TextStrokeTransparency = 0.6 + pulse * 0.3
end)

-- =============================================
--  2. FUNCIÓN DE TELETRANSPORTE
-- =============================================

local function teleportCharacter(targetPosition)
    local char = Player.Character
    if not char then
        print("⏳ Esperando personaje...")
        Player.CharacterAdded:Wait()
        char = Player.Character
        task.wait(0.5)
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        hrp = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("RootPart")
        if not hrp then
            warn("❌ No se encontró parte raíz.")
            return false
        end
    end

    -- CFrame directo
    pcall(function()
        hrp.CFrame = CFrame.new(targetPosition)
    end)
    task.wait(0.5)

    if (hrp.Position - targetPosition).Magnitude < 5 then
        print("✅ Teletransporte exitoso.")
        return true
    end

    -- MoveTo
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:MoveTo(targetPosition)
        task.wait(0.5)
        if (hrp.Position - targetPosition).Magnitude < 10 then
            print("✅ Teletransporte exitoso con MoveTo.")
            return true
        end
    end

    -- BodyPosition
    local bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyPos.P = 1e6
    bodyPos.D = 500
    bodyPos.Position = targetPosition
    bodyPos.Parent = hrp
    task.wait(1)
    bodyPos:Destroy()

    if (hrp.Position - targetPosition).Magnitude < 10 then
        print("✅ Teletransporte exitoso con BodyPosition.")
        return true
    end

    return false
end

-- =============================================
--  3. REINICIAR PERSONAJE (MATAR Y RESPAWNEAR)
-- =============================================

local function resetCharacter()
    print("🔄 Reiniciando personaje...")
    local char = Player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.Health = 0
            print("💀 Personaje muerto. Esperando respawn...")
            task.wait(2)
            Player.CharacterAdded:Wait()
            print("✅ Personaje respawneado.")
            task.wait(1)
            return true
        end
    end
    return false
end

-- =============================================
--  4. RECONEXIÓN AL JUEGO
-- =============================================

local function reconnectToGame()
    local placeId = 118418618261207  -- ID de RUNAWAYS

    print("🔄 Intentando reconectar a RUNAWAYS...")

    -- MÉTODO 1: TeleportService
    local success, err = pcall(function()
        TeleportService:Teleport(placeId, Player)
    end)
    if success then
        print("✅ Reconexión exitosa con TeleportService.")
        return true
    else
        print("⚠️ TeleportService falló: " .. tostring(err))
    end

    -- MÉTODO 2: TeleportToPlaceInstance
    success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, game.PlaceId, Player)
    end)
    if success then
        print("✅ Reconexión exitosa con TeleportToPlaceInstance.")
        return true
    else
        print("⚠️ TeleportToPlaceInstance falló: " .. tostring(err))
    end

    print("❌ No se pudo reconectar automáticamente. Deberás unirte manualmente.")
    return false
end

-- =============================================
--  5. FLUJO PRINCIPAL (CON LA ESPERA DE 3s)
-- =============================================

local function startAutoFarm()
    print("🚀 Iniciando Auto Farm...")

    -- PASO 1: Teletransportar a coordenadas
    local targetCoords = Vector3.new(354.564880, 2204.221924, 83581.523438)
    local success = teleportCharacter(targetCoords)

    if success then
        print("📍 Personaje en coordenadas:", targetCoords)
    else
        print("⚠️ No se pudo teletransportar completamente.")
    end

    -- PASO 2: Esperar 3 segundos
    print("⏳ Esperando 3 segundos...")
    task.wait(3)

    -- PASO 3: Reiniciar personaje (matar y respawn)
    resetCharacter()

    -- PASO 4: ✅ ESPERAR 3 SEGUNDOS DESPUÉS DEL REINICIO
    print("⏳ Esperando 3 segundos después del reinicio...")
    task.wait(3)

    -- PASO 5: Reconectar al juego
    reconnectToGame()
end

