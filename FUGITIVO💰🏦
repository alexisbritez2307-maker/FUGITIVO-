-- Animación de pulso para el brillo del texto
local pulseConnection
pulseConnection = RunService.RenderStepped:Connect(function()
    local t = tick()
    local pulse = (math.sin(t * 3) + 1) / 2  -- 0 a 1

    title.TextTransparency = 0.1 + pulse * 0.15
    glow1.TextTransparency = 0.2 + pulse * 0.3
    glow2.TextTransparency = 0.2 + pulse * 0.3
    glow3.TextTransparency = 0.4 + pulse * 0.4
