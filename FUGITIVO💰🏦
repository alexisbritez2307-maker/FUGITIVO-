-- TEXTO NEÓN CON MÚLTIPLES CAPAS Y BRILLO PULSANTE
local function createNeonText(parent, text, position, size, color, strokeColor, strokeTrans, zIndex)
    local label = Instance.new("TextLabel")
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeColor3 = strokeColor
    label.TextStrokeTransparency = strokeTrans
    label.ZIndex = zIndex
    label.Parent = parent
    return label
end

